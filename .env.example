# CloudBox 本地开发环境变量（模板，可提交；真实密钥填到 .env）
# 使用: cp .env.example .env

# ---------- MySQL（宿主 3307，避开本机 3306） ----------
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=cloudbox
MYSQL_USER=cloudbox
MYSQL_PASSWORD=cloudbox123456

# 后端 DSN（宿主直连用 3307；容器互联用 mysql:3306）
MYSQL_DSN=cloudbox:cloudbox123456@tcp(127.0.0.1:3307)/cloudbox?charset=utf8mb4&parseTime=True&loc=Local

# ---------- Redis（宿主 6380，避开 6379） ----------
REDIS_PORT=6380
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 后端 ----------
APP_PORT=8080
# 规范主变量（优先读取）；JWT_SECRET 仅兼容历史用法
# 注意：密钥必须 ≥32 字节，否则 jwt.NewManager 直接报错拒绝启动
CLOUDBOX_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
